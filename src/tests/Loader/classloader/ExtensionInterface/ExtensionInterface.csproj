<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RequiresProcessIsolation>true</RequiresProcessIsolation>
    <ReferenceXUnitWrapperGenerator>false</ReferenceXUnitWrapperGenerator>
    <CLRTestTargetUnsupported Condition="'$(RuntimeFlavor)' != 'coreclr'">true</CLRTestTargetUnsupported>
    <NativeAotIncompatible>true</NativeAotIncompatible>
    <R2RIncompatible>true</R2RIncompatible>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="ExtensionInterface.cs" />
    <Compile Include="OpenWitnessTests.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="ExtensionInterfaceForeignTypes.csproj" />
    <ProjectReference Include="ExtensionInterfaceTypes.ilproj" />
    <ProjectReference Include="OpenWitnessTypes.ilproj" />
  </ItemGroup>
</Project>
